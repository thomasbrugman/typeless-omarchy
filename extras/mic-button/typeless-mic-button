#!/usr/bin/python3
"""Turn a USB mic's hardware mute button into a dictation key.

The button on mics like the JIAYZ BY-GM18CU toggles a hardware mute and reports
nothing to the host (no HID event, no mixer change): a muted mic simply streams
exact digital zeros, while an unmuted one always carries some noise floor. This
watcher listens to the mic and drives a virtual key from the mute state.

Configuration (environment, e.g. ~/.config/typeless-mic-button.env):
  MIC_BUTTON_SOURCE  PulseAudio/PipeWire source of the mic
  MIC_BUTTON_KEY     voicecommand (default) or f13..f24
  MIC_BUTTON_MODIFIER  optional modifier held with the key: leftctrl,
                     rightctrl, leftalt, rightalt, leftshift, rightshift,
                     leftmeta, rightmeta (Wispr Flow requires one)
  MIC_BUTTON_MODE    tap (default): tap the key on every mute/unmute
                       -> Typeless, whose shortcuts are press-once toggles
                     hold: key held while the mic is live
                       -> Wispr Flow push-to-talk

The virtual device also advertises letter keys (Wispr Flow's helper only reads
devices that have them) and is disabled in Hyprland's config, so the key never
reaches applications; the dictation apps read it straight from evdev.
"""
import fcntl
import os
import signal
import struct
import subprocess
import sys
import time

SOURCE = os.environ.get(
    "MIC_BUTTON_SOURCE", "alsa_input.usb-JIAYZ_BY-GM18CU_20210513-00.mono-fallback")
DEVICE_NAME = b"Typeless Mic Button"   # Hyprland name: typeless-mic-button
KEYS = {"voicecommand": 0x246, **{f"f{n}": 183 + n - 13 for n in range(13, 25)}}
KEY_NAME = os.environ.get("MIC_BUTTON_KEY", "voicecommand").lower()
MODE = os.environ.get("MIC_BUTTON_MODE", "tap").lower()
if KEY_NAME not in KEYS or MODE not in ("tap", "hold"):
    sys.exit(f"bad MIC_BUTTON_KEY={KEY_NAME!r} or MIC_BUTTON_MODE={MODE!r}")
KEY = KEYS[KEY_NAME]
MODIFIERS = {"leftctrl": 29, "rightctrl": 97, "leftalt": 56, "rightalt": 100,
             "leftshift": 42, "rightshift": 54, "leftmeta": 125, "rightmeta": 126}
MOD_NAME = os.environ.get("MIC_BUTTON_MODIFIER", "").lower()
if MOD_NAME and MOD_NAME not in MODIFIERS:
    sys.exit(f"bad MIC_BUTTON_MODIFIER={MOD_NAME!r}")
CHORD = [MODIFIERS[MOD_NAME], KEY] if MOD_NAME else [KEY]
CHORD_NAME = "+".join(filter(None, [MOD_NAME, KEY_NAME]))
LETTER_KEYS = [*range(16, 26), *range(30, 39), *range(44, 51)]   # KEY_Q..P, A..L, Z..M
EV_SYN, EV_KEY, SYN_REPORT = 0x00, 0x01, 0

RATE = 16000
CHUNK_BYTES = RATE // 50 * 2          # 20 ms of s16le mono
MUTE_CHUNKS = 5                       # 100 ms of exact zeros -> muted
UNMUTE_CHUNKS = 2                     # 40 ms of signal -> live

UI_DEV_CREATE = 0x5501
UI_DEV_DESTROY = 0x5502
UI_SET_EVBIT = 0x40045564
UI_SET_KEYBIT = 0x40045565
UI_DEV_SETUP = 0x405C5503             # _IOW('U', 3, struct uinput_setup /* 92 bytes */)
BUS_VIRTUAL = 0x06


def log(msg):
    print(msg, flush=True)


class VirtualKey:
    def __init__(self):
        self.fd = os.open("/dev/uinput", os.O_WRONLY | os.O_NONBLOCK | os.O_CLOEXEC)
        fcntl.ioctl(self.fd, UI_SET_EVBIT, EV_KEY)
        for code in (*CHORD, *LETTER_KEYS):
            fcntl.ioctl(self.fd, UI_SET_KEYBIT, code)
        setup = struct.pack("HHHH80sI", BUS_VIRTUAL, 0x1209, 0x6d62, 1, DEVICE_NAME, 0)
        fcntl.ioctl(self.fd, UI_DEV_SETUP, setup)
        fcntl.ioctl(self.fd, UI_DEV_CREATE)
        self.down = False

    def _emit(self, etype, code, value):
        os.write(self.fd, struct.pack("llHHi", 0, 0, etype, code, value))

    def set(self, down):
        if down == self.down:
            return
        # Press modifier first, release it last.
        for code in (CHORD if down else reversed(CHORD)):
            self._emit(EV_KEY, code, 1 if down else 0)
            self._emit(EV_SYN, SYN_REPORT, 0)
        self.down = down

    def tap(self):
        self.set(True)
        time.sleep(0.04)
        self.set(False)

    def close(self):
        try:
            self.set(False)
            fcntl.ioctl(self.fd, UI_DEV_DESTROY)
        finally:
            os.close(self.fd)


def watch(key):
    """Capture until the source goes away. Returns when parec exits."""
    proc = subprocess.Popen(
        ["parec", "-d", SOURCE, "--format=s16le", f"--rate={RATE}", "--channels=1",
         "--raw", "--latency-msec=20", "--client-name=typeless-mic-button",
         "--stream-name=Mic button watcher"],
        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    zero = bytes(CHUNK_BYTES)
    live = None                       # unknown until the first stable reading
    zeros = signal_run = 0
    try:
        while True:
            buf = proc.stdout.read(CHUNK_BYTES)
            if len(buf) < CHUNK_BYTES:
                break
            if buf == zero:
                zeros, signal_run = zeros + 1, 0
            else:
                zeros, signal_run = 0, signal_run + 1
            if live is not False and zeros >= MUTE_CHUNKS:
                if live is not None:
                    log(f"muted -> {CHORD_NAME} {'tap' if MODE == 'tap' else 'up'}")
                    key.tap() if MODE == "tap" else key.set(False)
                else:
                    log("initial state: muted")
                live = False
            elif live is not True and signal_run >= UNMUTE_CHUNKS:
                if live is not None:
                    log(f"live -> {CHORD_NAME} {'tap' if MODE == 'tap' else 'down'}")
                    key.tap() if MODE == "tap" else key.set(True)
                else:
                    log("initial state: live (waiting for the next unmute)")
                live = True
    finally:
        key.set(False)
        proc.kill()
        proc.wait()


def main():
    key = VirtualKey()
    log(f"key={CHORD_NAME} mode={MODE} source={SOURCE}")
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    try:
        while True:
            watch(key)
            log(f"capture from {SOURCE} ended; retrying")
            time.sleep(2)
    finally:
        key.close()


if __name__ == "__main__":
    main()
